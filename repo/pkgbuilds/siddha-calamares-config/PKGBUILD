# Maintainer: Sydra OS Team <team@sydra-os.org>
pkgname=siddha-calamares-config
pkgver=0.1.0
pkgrel=1
pkgdesc="Calamares installer branding and configurations for Sydra OS"
arch=('any')
url="https://sydra-os.org"
license=('GPL-3.0-or-later')
source=()
sha256sums=()

package() {
  install -Dm644 "$startdir/settings.conf" "$pkgdir/etc/calamares/settings.conf"
  
  install -d "$pkgdir/etc/calamares/modules"
  install -m644 "$startdir/modules"/*.conf "$pkgdir/etc/calamares/modules/"
  
  install -d "$pkgdir/usr/share/calamares/branding/siddha"
  install -m644 "$startdir/branding"/* "$pkgdir/usr/share/calamares/branding/siddha/"
}
