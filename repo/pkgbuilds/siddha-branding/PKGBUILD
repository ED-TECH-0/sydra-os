# Maintainer: Sydra OS Team <team@sydra-os.org>
pkgname=siddha-branding
pkgver=0.1.0
pkgrel=5
pkgdesc="Branding, wallpapers, logos, and OS identity files for Sydra OS"
arch=('any')
url="https://sydra-os.org"
license=('GPL-3.0-or-later')
source=(
  'os-release'
  'issue'
  'sydra-logo.svg'
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  # OS release reference copies
  install -Dm644 "$srcdir/os-release" "$pkgdir/usr/share/siddha/branding/os-release"
  install -Dm644 "$srcdir/issue" "$pkgdir/usr/share/siddha/branding/issue"
  
  # Logo SVGs and Pixmaps
  install -Dm644 "$srcdir/sydra-logo.svg" "$pkgdir/usr/share/pixmaps/sydra-logo.svg"
  install -Dm644 "$srcdir/sydra-logo.svg" "$pkgdir/usr/share/siddha/branding/logo.svg"
  install -Dm644 "$startdir/icons/sydra-logo-512.png" "$pkgdir/usr/share/pixmaps/sydra-logo.png"
  install -Dm644 "$startdir/icons/sydra-logo-lockup.png" "$pkgdir/usr/share/siddha/branding/sydra-logo-lockup.png"

  # Hicolor Icon Theme entries
  install -Dm644 "$srcdir/sydra-logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sydra-logo.svg"
  for s in 16 24 32 48 64 128 256 512; do
    if [ -f "$startdir/icons/sydra-logo-${s}.png" ]; then
      install -Dm644 "$startdir/icons/sydra-logo-${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/sydra-logo.png"
    fi
  done

  # Wallpapers and KDE Wallpaper Package
  install -d "$pkgdir/usr/share/wallpapers/Sydra/contents/images"
  if compgen -G "$startdir/wallpapers/*.svg" > /dev/null; then
    cp "$startdir/wallpapers"/*.svg "$pkgdir/usr/share/wallpapers/Sydra/"
  fi
  if compgen -G "$startdir/wallpapers/*.png" > /dev/null; then
    cp "$startdir/wallpapers"/*.png "$pkgdir/usr/share/wallpapers/Sydra/"
  fi
  if [ -f "$startdir/wallpapers/sydra-obsidian-waves.png" ]; then
    install -Dm644 "$startdir/wallpapers/sydra-obsidian-waves.png" "$pkgdir/usr/share/wallpapers/Sydra/contents/images/3840x2160.png"
  fi
  if [ -f "$startdir/wallpapers/screenshot.png" ]; then
    install -Dm644 "$startdir/wallpapers/screenshot.png" "$pkgdir/usr/share/wallpapers/Sydra/contents/screenshot.png"
  fi
  if [ -f "$startdir/wallpapers/metadata.json" ]; then
    install -Dm644 "$startdir/wallpapers/metadata.json" "$pkgdir/usr/share/wallpapers/Sydra/metadata.json"
  fi
}
