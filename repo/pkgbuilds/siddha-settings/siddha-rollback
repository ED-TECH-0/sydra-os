#!/usr/bin/env bash
# Sydra OS Snapshot Rollback Tool
set -euo pipefail

echo "=============================================="
echo "         Sydra OS Snapshot Manager"
echo "=============================================="

if ! command -v snapper >/dev/null 2>&1; then
    echo "ERROR: Snapper is not installed or configured on this system." >&2
    exit 1
fi

ACTION=${1:-list}

case "$ACTION" in
    list)
        echo "Listing available system snapshots:"
        snapper list
        echo ""
        echo "To roll back to a specific snapshot number, run: sudo siddha-rollback <snapshot_num>"
        ;;
    [0-9]*)
        SNAP_NUM="$ACTION"
        echo "[!] Rolling back to snapshot #$SNAP_NUM..."
        sudo snapper rollback "$SNAP_NUM"
        echo "[+] Rollback target configured. Please reboot your system to boot into snapshot #$SNAP_NUM."
        ;;
    *)
        echo "Usage: siddha-rollback [list|<snapshot_number>]"
        exit 1
        ;;
esac
