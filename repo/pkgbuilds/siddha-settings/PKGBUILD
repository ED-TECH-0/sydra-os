# Maintainer: Sydra OS Team <team@sydra-os.org>
pkgname=siddha-settings
pkgver=0.1.0
pkgrel=3
pkgdesc="Default settings, sysctl, zram, snapshot rollback, updater, and shell profiles for Sydra OS"
arch=('any')
url="https://sydra-os.org"
license=('GPL-3.0-or-later')
source=(
  'zshrc'
  'bashrc'
  'starship.toml'
  '99-siddha.conf'
  'zram-generator.conf'
  'gamemode.ini'
  'siddha-glass-gamemode'
  'siddha-update'
  'siddha-rollback'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # Shell profile defaults
  install -Dm644 "$srcdir/zshrc" "$pkgdir/etc/skel/.zshrc"
  install -Dm644 "$srcdir/bashrc" "$pkgdir/etc/skel/.bashrc"
  install -Dm644 "$srcdir/starship.toml" "$pkgdir/etc/skel/.config/starship.toml"
  
  # Sysctl performance defaults
  install -Dm644 "$srcdir/99-siddha.conf" "$pkgdir/etc/sysctl.d/99-siddha.conf"
  
  # ZRAM configuration
  install -Dm644 "$srcdir/zram-generator.conf" "$pkgdir/etc/systemd/zram-generator.conf"
  
  # Gamemode hooks and management binaries
  install -Dm644 "$srcdir/gamemode.ini" "$pkgdir/etc/gamemode.ini"
  install -Dm755 "$srcdir/siddha-glass-gamemode" "$pkgdir/usr/bin/siddha-glass-gamemode"
  install -Dm755 "$srcdir/siddha-update" "$pkgdir/usr/bin/siddha-update"
  install -Dm755 "$srcdir/siddha-rollback" "$pkgdir/usr/bin/siddha-rollback"
}
