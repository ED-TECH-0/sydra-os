#!/usr/bin/env bash
set -euo pipefail

mkdir -p /var/log/siddha
exec > >(tee -a /var/log/siddha/installer.log) 2>&1

echo "=== Starting Sydra OS Installer at $(date) ==="
echo "User: $(whoami) [UID: $UID]"
echo "DISPLAY: ${DISPLAY:-unset}"
echo "WAYLAND_DISPLAY: ${WAYLAND_DISPLAY:-unset}"
echo "XDG_RUNTIME_DIR: ${XDG_RUNTIME_DIR:-unset}"

# Allow local root to access Xwayland
if command -v xhost >/dev/null 2>&1; then
    xhost +local:root 2>/dev/null || true
fi

# Ensure Wayland socket permissions for root
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    chmod 777 "$XDG_RUNTIME_DIR" 2>/dev/null || true
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        chmod 666 "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" 2>/dev/null || true
    fi
fi

# Launch with kdesu (KDE native) or sudo -E preserving Wayland environment
if [[ -x /usr/lib/kf6/kdesu ]]; then
    exec /usr/lib/kf6/kdesu -t -c "calamares -D 8"
elif command -v kdesu >/dev/null 2>&1; then
    exec kdesu -t -c "calamares -D 8"
else
    exec sudo -E \
        DISPLAY="${DISPLAY:-:0}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" \
        XAUTHORITY="${XAUTHORITY:-/home/live/.Xauthority}" \
        QT_QPA_PLATFORM="wayland;xcb" \
        calamares -D 8 "$@"
fi
