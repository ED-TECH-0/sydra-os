#!/usr/bin/env bash

LOG="/tmp/siddha-installer.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== Starting Sydra OS Installer at $(date) ==="
echo "User: $(whoami) [UID: $UID]"
echo "DISPLAY: ${DISPLAY:-unset}"
echo "WAYLAND_DISPLAY: ${WAYLAND_DISPLAY:-unset}"
echo "XDG_RUNTIME_DIR: ${XDG_RUNTIME_DIR:-unset}"

# Allow local root to access Xwayland / Wayland
if command -v xhost >/dev/null 2>&1; then
    xhost +si:localuser:root 2>/dev/null || xhost +local:root 2>/dev/null || true
fi

# Ensure Wayland socket permissions for root
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    chmod 777 "$XDG_RUNTIME_DIR" 2>/dev/null || true
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        chmod 666 "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" 2>/dev/null || true
    fi
fi

# Ensure squashfs source path exists for Calamares unpackfs
if [[ ! -f /run/archiso/bootmnt/sydra/x86_64/airootfs.sfs ]]; then
    FOUND_SFS=$(find /run /mnt /media -name "airootfs.sfs" 2>/dev/null | head -n1 || true)
    if [[ -n "$FOUND_SFS" && -f "$FOUND_SFS" ]]; then
        sudo mkdir -p /run/archiso/bootmnt/sydra/x86_64
        sudo ln -sf "$FOUND_SFS" /run/archiso/bootmnt/sydra/x86_64/airootfs.sfs
    fi
fi

# Ensure vmlinuz-linux source path exists for Calamares unpackfs
if [[ ! -f /run/archiso/bootmnt/sydra/boot/x86_64/vmlinuz-linux ]]; then
    FOUND_VMLINUZ=$(find /run/archiso /usr/lib/modules -name "vmlinuz" -type f 2>/dev/null | head -n1 || true)
    if [[ -n "$FOUND_VMLINUZ" && -f "$FOUND_VMLINUZ" ]]; then
        sudo mkdir -p /run/archiso/bootmnt/sydra/boot/x86_64
        sudo cp -f "$FOUND_VMLINUZ" /run/archiso/bootmnt/sydra/boot/x86_64/vmlinuz-linux
    fi
fi

# Ensure microcode source paths exist for Calamares unpackfs
for ucode in intel-ucode.img amd-ucode.img; do
    if [[ ! -f "/run/archiso/bootmnt/sydra/boot/$ucode" ]]; then
        FOUND_UCODE=$(find /run/archiso /boot /usr/share -name "$ucode" -type f 2>/dev/null | head -n1 || true)
        if [[ -n "$FOUND_UCODE" && -f "$FOUND_UCODE" ]]; then
            sudo mkdir -p /run/archiso/bootmnt/sydra/boot
            sudo cp -f "$FOUND_UCODE" "/run/archiso/bootmnt/sydra/boot/$ucode"
        fi
    fi
done

# Run Calamares with sudo -E preserving display variables
sudo -E \
    DISPLAY="${DISPLAY:-:0}" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" \
    XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
    QT_QPA_PLATFORM="wayland;xcb" \
    calamares -D 8 "$@"
STATUS=$?

if [[ $STATUS -ne 0 ]]; then
    echo "Calamares exited with error code $STATUS"
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Sydra OS Installer Error" --error "Calamares failed to start (exit code $STATUS).\n\nDetails:\n$(tail -n 20 "$LOG")" 2>/dev/null || true
    fi
fi
