#!/usr/bin/env bash
# Sydra OS Live Desktop Initializer
# Ensures wallpaper, colorscheme, and desktop icons are properly initialized

# 1. Wait for Plasma Shell DBus service to be registered
for i in $(seq 1 12); do
    if qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.dumpCurrentLayoutMainScript >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# 2. Apply Sydra Obsidian Waves wallpaper
WALLPAPER="/usr/share/wallpapers/Sydra/contents/images/3840x2160.png"
if [ ! -f "$WALLPAPER" ]; then
    WALLPAPER="/usr/share/wallpapers/Sydra/sydra-obsidian-waves.png"
fi

if [ -f "$WALLPAPER" ] && command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage "$WALLPAPER" 2>/dev/null || true
fi

# 3. Apply Siddha Glass Graphite color scheme
if command -v plasma-apply-colorscheme >/dev/null 2>&1; then
    plasma-apply-colorscheme "SiddhaGlassGraphite" 2>/dev/null || true
fi

# 4. Ensure desktop installer icon is trusted and executable
if [ -f "$HOME/Desktop/siddha-installer.desktop" ]; then
    chmod +x "$HOME/Desktop/siddha-installer.desktop"
fi

exit 0
