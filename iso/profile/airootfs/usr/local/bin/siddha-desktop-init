#!/usr/bin/env bash
# Sydra OS Live Desktop Initializer
# Ensures wallpaper, colorscheme, and desktop icons are properly initialized

# 1. Ensure desktop installer icon is trusted and executable
if [ -f "$HOME/Desktop/siddha-installer.desktop" ]; then
    chmod +x "$HOME/Desktop/siddha-installer.desktop" 2>/dev/null || true
fi

# 2. Apply COSMIC Glassy and Panel/Dock settings
if [ -f "/usr/bin/siddha-glass-set" ]; then
    /usr/bin/siddha-glass-set obsidian pro 2>/dev/null || true
fi

# 3. Ensure polkit helper has SUID permission
chmod 4755 /usr/lib/polkit-1/polkit-agent-helper-1 2>/dev/null || true

# 4. Ensure Flathub repository is registered for Flatpaks (in background)
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null &
fi

exit 0
